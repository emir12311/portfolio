---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../content/site';

const visibleSections = site.sections.filter((section) => section.visible);
const { notFound } = site.ui;
---

<PageLayout title={`404 — ${site.name}`} description={notFound.body} noindex>
  <section class="not-found">
    <div class="container not-found__inner">
      <div class="not-found__meta">
        <span class="not-found__code mono" aria-hidden="true">404</span>
        <span class="not-found__rule" aria-hidden="true"></span>
      </div>

      <h1 class="not-found__title">{notFound.title}</h1>
      <p class="not-found__body">{notFound.body}</p>

      <nav class="not-found__nav" aria-label={site.ui.navLabel}>
        <ul class="not-found__list">
          <li>
            <a class="not-found__link" href="/">{notFound.home}</a>
          </li>
          {visibleSections.map((section) => (
            <li>
              <a class="not-found__link" href={section.path}>
                {section.navLabel}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</PageLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: calc(100svh - 12rem);
    border-bottom: var(--line-width) solid var(--color-line-strong);
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    width: 100%;
    padding-block: clamp(3rem, 10vh, 8rem);
  }

  .not-found__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    color: var(--color-accent);
  }

  .not-found__code {
    letter-spacing: var(--tracking-wide);
  }

  .not-found__rule {
    height: var(--line-width);
    flex: 1;
    background: var(--color-line-strong);
  }

  .not-found__title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.84;
  }

  .not-found__body {
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
    line-height: var(--leading-snug);
  }

  .not-found__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-md);
  }

  .not-found__link {
    display: inline-block;
    padding: 0.7rem 0.85rem;
    border: var(--line-width) solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color var(--dur-fast) var(--ease-in-out),
      border-color var(--dur-fast) var(--ease-in-out),
      color var(--dur-fast) var(--ease-in-out);
  }

  .not-found__link:hover,
  .not-found__link:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__link {
      transition: none;
    }
  }
</style>
