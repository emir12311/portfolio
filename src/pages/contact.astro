---
import PageLayout from '../layouts/PageLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../content/site';
import { buildGraph, pageDescription } from '../lib/seo';

const visibleSections = site.sections.filter((section) => section.visible);
const section = site.sections.find((item) => item.id === 'contact')!;
const order = visibleSections.findIndex((item) => item.id === 'contact') + 1;

const description = pageDescription('contact');
const schema = buildGraph({
  path: '/contact',
  name: section.label,
  description,
  kind: 'ContactPage',
});
---

<PageLayout
  title={`${section.label} — ${site.name}`}
  description={description}
  current="contact"
  schema={schema}
>
  <PageIntro index={order} label={section.label} />
  <ContactSection section={section} links={site.contact} order={order} showHeading={false} />
</PageLayout>
