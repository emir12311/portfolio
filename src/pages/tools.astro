---
import PageLayout from '../layouts/PageLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SkillsSection from '../components/SkillsSection.astro';
import { site } from '../content/site';
import { buildGraph, pageDescription } from '../lib/seo';

const visibleSections = site.sections.filter((section) => section.visible);
const section = site.sections.find((item) => item.id === 'skills')!;
const order = visibleSections.findIndex((item) => item.id === 'skills') + 1;

const description = pageDescription('skills');
const schema = buildGraph({
  path: '/tools',
  name: section.label,
  description,
  kind: 'CollectionPage',
});

const tokens = (value: string) =>
  value
    .toLowerCase()
    .split(/[^a-z0-9+#.]+/)
    .filter(Boolean);

/**
 * Derived, not authored: which projects actually use each listed tool.
 * Matches on whole tokens so "C" cannot match "TypeScript", and treats the
 * "AI directing" entry as the projects flagged aiDirected.
 */
const usage: Record<string, { id: string; name: string }[]> = {};

for (const group of site.skills) {
  for (const item of group.items) {
    const key = item.toLowerCase().trim();
    const keyTokens = tokens(item);

    const matches = site.projects.filter((project) => {
      if (key === 'ai directing') return Boolean(project.aiDirected);

      return project.tech.some((tech) => {
        if (tech.toLowerCase().trim() === key) return true;
        const techTokens = tokens(tech);
        return keyTokens.some((token) => techTokens.includes(token));
      });
    });

    if (matches.length > 0) {
      usage[item] = matches.map(({ id, name }) => ({ id, name }));
    }
  }
}
---

<PageLayout
  title={`${section.label} — ${site.name}`}
  description={description}
  current="skills"
  schema={schema}
>
  <PageIntro index={order} label={section.label} />

  <SkillsSection
    section={section}
    groups={site.skills}
    order={order}
    showHeading={false}
    groupLevel={2}
    usage={usage}
    usedInLabel={site.ui.toolsUsedIn}
  />

  <section class="stacks" aria-labelledby="stacks-title">
    <div class="container stacks__inner">
      <h2 class="stacks__title mono" id="stacks-title">{site.ui.toolsProjects}</h2>
      <ul class="stacks__list">
        {site.projects.map((project) => (
          <li class="stacks__item">
            <a class="stacks__link" href={`/projects#detail-${project.id}`}>
              <span class="stacks__name">{project.name}</span>
              <span class="stacks__tech">{project.tech.join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .stacks {
    border-top: var(--line-width) solid var(--color-line-strong);
  }

  .stacks__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 6rem);
  }

  .stacks__title {
    color: var(--color-text-muted);
  }

  .stacks__list {
    border-top: var(--line-width) solid var(--color-line);
  }

  .stacks__item {
    border-bottom: var(--line-width) solid var(--color-line);
  }

  .stacks__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
    padding-block: clamp(0.9rem, 2vw, 1.4rem);
    text-decoration: none;
    transition:
      background-color var(--dur-mid) var(--ease-in-out),
      padding var(--dur-mid) var(--ease-spring);
  }

  .stacks__link:hover,
  .stacks__link:focus-visible {
    padding-inline: var(--space-md);
    background: var(--color-accent-soft);
  }

  .stacks__name {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
  }

  .stacks__tech {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .stacks__link {
      transition: none;
    }
  }
</style>
