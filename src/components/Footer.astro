---
import Icon from './Icon.astro';

interface Props {
  name: string;
  handle: string;
  backToTop: string;
  copyright: string;
}

const { name, handle, backToTop, copyright } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand" data-reveal="wipe">
      <span class="site-footer__name">{name}</span>
      <span class="site-footer__handle">@{handle}</span>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">{copyright}</p>
      <a class="site-footer__top" href="#top">
        <span>{backToTop}</span>
        <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 0.3rem solid var(--color-accent);
    background: var(--color-invert-bg);
    color: var(--color-invert-text);
    transition:
      background-color var(--dur-mid) var(--ease-out),
      color var(--dur-mid) var(--ease-out);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: clamp(3rem, 8vw, 7rem) var(--space-xl);
  }

  .site-footer__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-footer__name {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 9.5vw, 9.5rem);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-none);
  }

  .site-footer__handle {
    padding-bottom: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.02em;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-top: var(--space-md);
    border-top: var(--line-width) solid color-mix(in srgb, currentColor 28%, transparent);
  }

  .site-footer__copyright {
    color: color-mix(in srgb, currentColor 72%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
  }

  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.6rem 0.7rem;
    border: var(--line-width) solid currentColor;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color var(--dur-fast) var(--ease-in-out),
      color var(--dur-fast) var(--ease-in-out),
      translate var(--dur-fast) var(--ease-in-out);
  }

  .site-footer__top:hover,
  .site-footer__top:focus-visible {
    background: var(--color-accent);
    color: var(--color-on-accent);
    translate: 0 -0.2rem;
  }

  .site-footer__top :global(svg) {
    transition: translate var(--dur-fast) var(--ease-out);
  }

  .site-footer__top:hover :global(svg),
  .site-footer__top:focus-visible :global(svg) {
    translate: 0 -0.2rem;
  }

  @media (max-width: 40rem) {
    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__top,
    .site-footer__top :global(svg) {
      transition: none;
    }
  }
</style>
