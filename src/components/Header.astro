---
import type { Section, SectionId } from '../content/site';

interface Props {
  name: string;
  handle: string;
  sections: Section[];
  navLabel: string;
  menuLabel: string;
  current?: SectionId;
}

const { name, handle, sections, navLabel, menuLabel, current } = Astro.props;
---

<header class="site-header">
  <span class="site-header__progress" aria-hidden="true"></span>
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__name">{name}</span>
      <span class="site-header__handle">@{handle}</span>
    </a>

    <nav class="site-header__desktop" aria-label={navLabel}>
      <ul class="site-header__links">
        {sections.map((section) => (
          <li>
            <a
              class="site-header__link"
              href={section.path}
              aria-current={current === section.id ? 'page' : undefined}
            >
              {section.navLabel}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <details class="mobile-menu" data-mobile-menu>
        <summary class="mobile-menu__summary">{menuLabel}</summary>
        <nav class="mobile-menu__nav" aria-label={navLabel}>
          <ul>
            {sections.map((section, index) => (
              <li>
                <a
                  class="mobile-menu__link"
                  href={section.path}
                  aria-current={current === section.id ? 'page' : undefined}
                >
                  <span class="mobile-menu__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span>{section.navLabel}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-mobile-menu]'));

  for (const menu of menus) {
    for (const link of menu.querySelectorAll('a')) {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    }

    document.addEventListener('pointerdown', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-top: 0.3rem solid var(--color-accent);
    border-bottom: var(--line-width) solid var(--color-line-strong);
    background: var(--color-bg);
    transition:
      background-color var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out);
  }

  .site-header__progress {
    position: absolute;
    right: 0;
    bottom: calc(var(--line-width) * -1);
    left: 0;
    height: 0.28rem;
    background: var(--color-accent-2);
    scale: 0 1;
    transform-origin: 0 50%;
  }

  @supports (animation-timeline: scroll()) {
    .site-header__progress {
      animation: header-progress linear both;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes header-progress {
    from {
      scale: 0 1;
    }

    to {
      scale: 1 1;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 4.7rem;
    padding-block: var(--header-pad);
  }

  .site-header__brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
  }

  .site-header__brand::before {
    width: 0.7em;
    height: 0.7em;
    flex: none;
    background: var(--color-accent);
    content: '';
    rotate: 45deg;
    transition:
      background-color var(--dur-mid) var(--ease-out),
      rotate var(--dur-slow) var(--ease-out);
  }

  .site-header__brand:hover::before {
    background: var(--color-accent-2);
    rotate: 225deg;
  }

  .site-header__name {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .site-header__handle {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .site-header__desktop {
    margin-left: auto;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .site-header__link {
    display: block;
    padding: 0.45rem 0.55rem;
    border: var(--line-width) solid transparent;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color var(--dur-fast) var(--ease-in-out),
      border-color var(--dur-fast) var(--ease-in-out),
      color var(--dur-fast) var(--ease-in-out);
  }

  .site-header__link:hover,
  .site-header__link:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .site-header__link[aria-current='page'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .site-header__link[aria-current='page']:hover,
  .site-header__link[aria-current='page']:focus-visible {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .site-header__tools {
    display: none;
    flex: none;
    align-items: center;
    gap: var(--space-md);
    margin-left: 0;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.85rem;
    padding: 0.35rem 0.55rem;
    border: var(--line-width) solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    list-style: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mobile-menu__summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__summary::after {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--color-accent);
    content: '';
    transition: rotate var(--dur-mid) var(--ease-out);
  }

  .mobile-menu[open] .mobile-menu__summary::after {
    rotate: 45deg;
  }

  .mobile-menu__nav {
    position: absolute;
    top: calc(100% + 0.8rem);
    right: 0;
    z-index: var(--z-mobile-nav);
    width: min(82vw, 21rem);
    border: var(--line-width) solid var(--color-line-strong);
    background: var(--color-bg);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--color-hard-shadow);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md);
    border-top: var(--line-width) solid var(--color-line);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-in-out),
      color var(--dur-fast) var(--ease-in-out);
  }

  .mobile-menu li:first-child .mobile-menu__link {
    border-top: 0;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link:focus-visible {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .mobile-menu__link[aria-current='page'] {
    background: var(--color-accent-soft);
  }

  .mobile-menu__index {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
  }

  .mobile-menu__link:hover .mobile-menu__index,
  .mobile-menu__link:focus-visible .mobile-menu__index {
    color: currentColor;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 56rem) {
    .site-header__inner {
      gap: var(--space-md);
    }

    .site-header__brand {
      flex: 1 1 12rem;
    }

    .site-header__desktop {
      display: none;
    }

    .site-header__tools {
      display: flex;
      gap: var(--space-sm);
      margin-left: auto;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      align-items: flex-start;
    }

    .site-header__brand {
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-sm);
    }

    .site-header__handle {
      flex-basis: 100%;
      padding-left: 1.35em;
    }
  }

  @media (max-width: 23rem) {
    .site-header__tools {
      gap: var(--space-2xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__progress {
      animation: none;
    }

    .site-header__brand::before,
    .site-header__link,
    .mobile-menu__summary::after,
    .mobile-menu__link {
      transition: none;
    }
  }
</style>
