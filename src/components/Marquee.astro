---
interface Props {
  items: string[];
}

const { items } = Astro.props;
const duration = Math.max(22, items.length * 3.2);
---

<div class="marquee" aria-hidden="true" style={`--marquee-duration: ${duration}s`}>
  <div class="marquee__track">
    {[0, 1].map(() => (
      <ul class="marquee__group">
        {items.map((item) => (
          <li class="marquee__item">{item}</li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: var(--line-width) solid var(--color-line-strong);
    background: var(--color-surface);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(0.8rem, 1.6vw, 1.3rem) clamp(0.75rem, 2vw, 2rem)
      clamp(0.8rem, 1.6vw, 1.3rem) clamp(1.5rem, 4vw, 4rem);
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: 1;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .marquee__item::after {
    width: 0.55em;
    height: 0.55em;
    flex: none;
    background: var(--color-accent);
    content: '';
    rotate: 45deg;
  }

  @keyframes marquee {
    to {
      translate: -50% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
