---
interface Props {
  index: number;
  label: string;
}

const { index, label } = Astro.props;
---

<header class="page-intro" id="top">
  <div class="container page-intro__inner">
    <div class="page-intro__meta">
      <span class="page-intro__index mono" aria-hidden="true">{String(index).padStart(2, '0')}</span>
      <span class="page-intro__rule" aria-hidden="true"></span>
    </div>
    <h1 class="page-intro__title">{label}</h1>
  </div>
</header>

<style>
  .page-intro {
    position: relative;
    border-bottom: var(--line-width) solid var(--color-line-strong);
  }

  .page-intro__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: clamp(2.5rem, 9vh, 7rem) clamp(1.5rem, 5vh, 3.5rem);
  }

  .page-intro__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    color: var(--color-accent);
  }

  .page-intro__rule {
    height: var(--line-width);
    flex: 1;
    background: var(--color-line-strong);
    scale: 0 1;
    transform-origin: 0 50%;
    animation: page-rule-draw 1400ms var(--ease-dramatic) 180ms both;
  }

  .page-intro__title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.82;
    animation: page-title-in 1150ms var(--ease-dramatic) 60ms both;
  }

  @keyframes page-rule-draw {
    from {
      scale: 0 1;
    }

    to {
      scale: 1 1;
    }
  }

  @keyframes page-title-in {
    from {
      opacity: 0;
      translate: 0 0.32em;
      filter: blur(12px);
    }

    to {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-intro__rule,
    .page-intro__title {
      animation: none;
    }
  }
</style>
